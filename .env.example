# ============================================================================
# Eye in the Sky — environment configuration (copy to .env and edit).
# No secrets belong in this repo; .env is gitignored.
# Every variable below has a safe default in code; this file documents them all.
# ============================================================================

# ---- Shared link config (ground <-> companion) ----------------------------
EIS_HOST=sitl                  # Jetson IP (e.g. 192.168.1.42) or "sitl"
EIS_CONTROL_PORT=8765          # control + telemetry WebSocket port
EIS_VIDEO_URL=                 # rtsp://<host>:8554/stream or webrtc/whep URL; empty = mock canvas
EIS_SITL=true                  # true → connect to a local SITL + companion stack

# ---- Companion: flight controller link ------------------------------------
# SITL uses UDP; real hardware uses the Jetson UART to the FC.
EIS_FC_CONNECTION=udp:127.0.0.1:14550   # real HW e.g. /dev/ttyTHS1
EIS_FC_BAUD=921600                       # serial baud (ignored for udp/tcp)
EIS_MAVLINK_SYSID=1                       # FC system id
EIS_GCS_SYSID=255                         # this companion's GCS system id

# ---- Companion: camera / vision -------------------------------------------
EIS_CAMERA_SOURCE=csi          # csi (nvarguscamerasrc) | v4l2 | file | mock
EIS_CAMERA_DEVICE=/dev/video0  # used when EIS_CAMERA_SOURCE=v4l2
EIS_CAMERA_WIDTH=1280
EIS_CAMERA_HEIGHT=720
EIS_CAMERA_FPS=30
EIS_MODEL_PATH=weights/yolo11n.pt        # pretrained person detector (COCO)
EIS_ENGINE_PATH=weights/yolo11n.engine   # exported TensorRT engine (Jetson)
EIS_DETECT_CONF=0.4

# ---- Companion: video stream ----------------------------------------------
EIS_VIDEO_PORT=8554            # RTSP port served by mediamtx/GStreamer
EIS_VIDEO_BITRATE=2500         # kbps
EIS_WEBRTC_PORT=8889           # mediamtx WebRTC/WHEP port (low-latency UI playback)

# ---- Companion: guidance / safety limits (override config/*.yaml) ---------
EIS_STANDOFF_M=5               # default standoff distance (min enforced 3 m)
EIS_MAX_SPEED_MPS=2            # conservative default cap
EIS_MAX_ALT_M=30               # altitude cap (also set as FC geofence)
EIS_GEOFENCE_RADIUS_M=60
EIS_CONFIG=config/default.yaml # config/sitl.yaml for simulation

# ---- Ground app (Electron) -------------------------------------------------
EIS_RECORDINGS_DIR=            # default: app userData/recordings
