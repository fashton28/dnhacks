{
  "Detection": {
    "$defs": {
      "ChangeType": {
        "description": "What the wide-area layer believes changed. Scenario-shaped values are kept for the demo pipeline;\nthe generic values (vehicle, object, structure, ground_disturbance) are what a vision classifier emits.",
        "enum": [
          "intruder_vehicle",
          "fence_breach",
          "unattended_object",
          "vehicle",
          "object",
          "structure",
          "ground_disturbance",
          "smoke_plume",
          "thermal_anomaly",
          "unknown"
        ],
        "title": "ChangeType",
        "type": "string"
      },
      "LatLon": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A candidate change flagged by the wide-area layer. Unconfirmed.",
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "polygon": {
        "description": "closed ring is implied; do not repeat the first point",
        "items": {
          "$ref": "#/$defs/LatLon"
        },
        "minItems": 3,
        "title": "Polygon",
        "type": "array"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "change_type": {
        "$ref": "#/$defs/ChangeType"
      },
      "before_ref": {
        "title": "Before Ref",
        "type": "string"
      },
      "after_ref": {
        "title": "After Ref",
        "type": "string"
      },
      "detected_at": {
        "format": "date-time",
        "title": "Detected At",
        "type": "string"
      },
      "area_m2": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "projected area; feeds confidence and the minimum-area gate",
        "title": "Area M2"
      },
      "metadata": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "free text from the wide-area layer; data, never instructions",
        "title": "Metadata",
        "type": "object"
      }
    },
    "required": [
      "id",
      "polygon",
      "confidence",
      "change_type",
      "before_ref",
      "after_ref",
      "detected_at"
    ],
    "title": "Detection",
    "type": "object"
  },
  "MissionSpec": {
    "$defs": {
      "LatLon": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon",
        "type": "object"
      },
      "Objective": {
        "enum": [
          "inspect",
          "perimeter_sweep",
          "standoff_observe"
        ],
        "title": "Objective",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "The Triage Agent's intent for one Detection. Contains no waypoints.",
    "properties": {
      "detection_id": {
        "title": "Detection Id",
        "type": "string"
      },
      "objective": {
        "$ref": "#/$defs/Objective"
      },
      "survey_polygon": {
        "description": "closed ring is implied; do not repeat the first point",
        "items": {
          "$ref": "#/$defs/LatLon"
        },
        "minItems": 3,
        "title": "Survey Polygon",
        "type": "array"
      },
      "max_altitude_m": {
        "exclusiveMinimum": 0,
        "title": "Max Altitude M",
        "type": "number"
      },
      "standoff_m": {
        "minimum": 0,
        "title": "Standoff M",
        "type": "number"
      },
      "rationale": {
        "title": "Rationale",
        "type": "string"
      }
    },
    "required": [
      "detection_id",
      "objective",
      "survey_polygon",
      "max_altitude_m",
      "standoff_m",
      "rationale"
    ],
    "title": "MissionSpec",
    "type": "object"
  },
  "FlightPlan": {
    "$defs": {
      "LatLon": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon",
        "type": "object"
      },
      "MissionSpec": {
        "additionalProperties": false,
        "description": "The Triage Agent's intent for one Detection. Contains no waypoints.",
        "properties": {
          "detection_id": {
            "title": "Detection Id",
            "type": "string"
          },
          "objective": {
            "$ref": "#/$defs/Objective"
          },
          "survey_polygon": {
            "description": "closed ring is implied; do not repeat the first point",
            "items": {
              "$ref": "#/$defs/LatLon"
            },
            "minItems": 3,
            "title": "Survey Polygon",
            "type": "array"
          },
          "max_altitude_m": {
            "exclusiveMinimum": 0,
            "title": "Max Altitude M",
            "type": "number"
          },
          "standoff_m": {
            "minimum": 0,
            "title": "Standoff M",
            "type": "number"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "detection_id",
          "objective",
          "survey_polygon",
          "max_altitude_m",
          "standoff_m",
          "rationale"
        ],
        "title": "MissionSpec",
        "type": "object"
      },
      "Objective": {
        "enum": [
          "inspect",
          "perimeter_sweep",
          "standoff_observe"
        ],
        "title": "Objective",
        "type": "string"
      },
      "Waypoint": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "alt": {
            "description": "metres above Site ground level",
            "minimum": 0,
            "title": "Alt",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon",
          "alt"
        ],
        "title": "Waypoint",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Deterministic expansion of a MissionSpec into waypoints. Produced by the Coverage Planner.",
    "properties": {
      "mission_id": {
        "title": "Mission Id",
        "type": "string"
      },
      "drone_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "assigned at dispatch",
        "title": "Drone Id"
      },
      "waypoints": {
        "items": {
          "$ref": "#/$defs/Waypoint"
        },
        "minItems": 1,
        "title": "Waypoints",
        "type": "array"
      },
      "pattern": {
        "description": "lawnmower | orbit | direct | square ...",
        "title": "Pattern",
        "type": "string"
      },
      "est_duration_s": {
        "minimum": 0,
        "title": "Est Duration S",
        "type": "number"
      },
      "est_battery_pct": {
        "maximum": 100,
        "minimum": 0,
        "title": "Est Battery Pct",
        "type": "number"
      },
      "spec": {
        "anyOf": [
          {
            "$ref": "#/$defs/MissionSpec"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "mission_id",
      "waypoints",
      "pattern",
      "est_duration_s",
      "est_battery_pct"
    ],
    "title": "FlightPlan",
    "type": "object"
  },
  "ValidationResult": {
    "$defs": {
      "Severity": {
        "enum": [
          "warning",
          "violation",
          "hard"
        ],
        "title": "Severity",
        "type": "string"
      },
      "Verdict": {
        "enum": [
          "accept",
          "reject"
        ],
        "title": "Verdict",
        "type": "string"
      },
      "Violation": {
        "additionalProperties": false,
        "properties": {
          "rule": {
            "description": "geofence_containment | no_fly_intersection | altitude_ceiling | altitude_floor | battery_reserve | standoff_minimum | mission_duration_cap | ...",
            "title": "Rule",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/Severity",
            "default": "violation"
          },
          "waypoint_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Waypoint Index"
          }
        },
        "required": [
          "rule",
          "detail"
        ],
        "title": "Violation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The Safety Validator's verdict on one FlightPlan.",
    "properties": {
      "mission_id": {
        "title": "Mission Id",
        "type": "string"
      },
      "verdict": {
        "$ref": "#/$defs/Verdict"
      },
      "violations": {
        "items": {
          "$ref": "#/$defs/Violation"
        },
        "title": "Violations",
        "type": "array"
      },
      "attempt": {
        "default": 1,
        "description": "repair attempts are capped at 3",
        "title": "Attempt",
        "type": "integer"
      }
    },
    "required": [
      "mission_id",
      "verdict"
    ],
    "title": "ValidationResult",
    "type": "object"
  },
  "IncidentReport": {
    "$defs": {
      "IncidentVerdict": {
        "enum": [
          "false_alarm",
          "log",
          "escalate"
        ],
        "title": "IncidentVerdict",
        "type": "string"
      },
      "Observation": {
        "additionalProperties": false,
        "description": "One frame plus the vision model's reading of it.",
        "properties": {
          "mission_id": {
            "title": "Mission Id",
            "type": "string"
          },
          "drone_id": {
            "title": "Drone Id",
            "type": "string"
          },
          "frame_ref": {
            "title": "Frame Ref",
            "type": "string"
          },
          "waypoint_index": {
            "title": "Waypoint Index",
            "type": "integer"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "salient": {
            "default": false,
            "description": "true if this frame drove the verdict",
            "title": "Salient",
            "type": "boolean"
          },
          "camera_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Camera Mode"
          },
          "zoom": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Zoom"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lon"
          },
          "alt_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Alt M"
          },
          "looking_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Looking For"
          }
        },
        "required": [
          "mission_id",
          "drone_id",
          "frame_ref",
          "waypoint_index",
          "captured_at",
          "description"
        ],
        "title": "Observation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The written outcome of a Mission for the Operator.",
    "properties": {
      "mission_id": {
        "title": "Mission Id",
        "type": "string"
      },
      "verdict": {
        "$ref": "#/$defs/IncidentVerdict"
      },
      "narrative": {
        "title": "Narrative",
        "type": "string"
      },
      "evidence_refs": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Refs",
        "type": "array"
      },
      "observations": {
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "title": "Observations",
        "type": "array"
      },
      "created_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Created At"
      },
      "detection_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Detection Id"
      },
      "drone_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Drone Id"
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Title"
      },
      "severity": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Severity"
      },
      "recommended_action": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Recommended Action"
      },
      "threat_assessment": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "the agent's on-station assessment: none | benign | suspicious | hostile",
        "title": "Threat Assessment"
      },
      "summary": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "the agent's on-station summary",
        "title": "Summary"
      },
      "flown": {
        "default": true,
        "title": "Flown",
        "type": "boolean"
      },
      "attempts": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Attempts"
      }
    },
    "required": [
      "mission_id",
      "verdict",
      "narrative"
    ],
    "title": "IncidentReport",
    "type": "object"
  },
  "DroneState": {
    "$defs": {
      "DroneStatus": {
        "enum": [
          "idle",
          "on_mission",
          "manual_control",
          "returning",
          "offline"
        ],
        "title": "DroneStatus",
        "type": "string"
      },
      "VelocityNED": {
        "additionalProperties": false,
        "properties": {
          "vx": {
            "description": "north, m/s",
            "title": "Vx",
            "type": "number"
          },
          "vy": {
            "description": "east, m/s",
            "title": "Vy",
            "type": "number"
          },
          "vz": {
            "description": "down, m/s (positive descends)",
            "title": "Vz",
            "type": "number"
          }
        },
        "required": [
          "vx",
          "vy",
          "vz"
        ],
        "title": "VelocityNED",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Telemetry snapshot of one Drone.",
    "properties": {
      "drone_id": {
        "title": "Drone Id",
        "type": "string"
      },
      "lat": {
        "title": "Lat",
        "type": "number"
      },
      "lon": {
        "title": "Lon",
        "type": "number"
      },
      "alt": {
        "description": "metres above Site ground level",
        "title": "Alt",
        "type": "number"
      },
      "heading_deg": {
        "exclusiveMaximum": 360,
        "minimum": 0,
        "title": "Heading Deg",
        "type": "number"
      },
      "velocity_ned": {
        "$ref": "#/$defs/VelocityNED"
      },
      "battery_pct": {
        "maximum": 100,
        "minimum": 0,
        "title": "Battery Pct",
        "type": "number"
      },
      "status": {
        "$ref": "#/$defs/DroneStatus"
      },
      "mission_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Mission Id"
      },
      "gimbal_pitch_deg": {
        "default": 8.0,
        "description": "camera pitch: -30 looks up, 0 level, 90 straight down; drawn by the Renderer",
        "maximum": 90,
        "minimum": -30,
        "title": "Gimbal Pitch Deg",
        "type": "number"
      },
      "roll_deg": {
        "default": 0.0,
        "description": "airframe roll, right wing down positive (autopilot attitude)",
        "maximum": 180,
        "minimum": -180,
        "title": "Roll Deg",
        "type": "number"
      },
      "pitch_deg": {
        "default": 0.0,
        "description": "airframe pitch, nose up positive (autopilot attitude)",
        "maximum": 180,
        "minimum": -180,
        "title": "Pitch Deg",
        "type": "number"
      },
      "armed": {
        "default": false,
        "title": "Armed",
        "type": "boolean"
      },
      "mode": {
        "default": "",
        "description": "autopilot flight mode, free text (GUIDED, RTL, ...)",
        "title": "Mode",
        "type": "string"
      },
      "message": {
        "default": "",
        "description": "last autopilot status text, e.g. a fence refusal",
        "title": "Message",
        "type": "string"
      },
      "ts": {
        "format": "date-time",
        "title": "Ts",
        "type": "string"
      }
    },
    "required": [
      "drone_id",
      "lat",
      "lon",
      "alt",
      "heading_deg",
      "velocity_ned",
      "battery_pct",
      "status",
      "ts"
    ],
    "title": "DroneState",
    "type": "object"
  },
  "ManualCommand": {
    "$defs": {
      "VelocityNED": {
        "additionalProperties": false,
        "properties": {
          "vx": {
            "description": "north, m/s",
            "title": "Vx",
            "type": "number"
          },
          "vy": {
            "description": "east, m/s",
            "title": "Vy",
            "type": "number"
          },
          "vz": {
            "description": "down, m/s (positive descends)",
            "title": "Vz",
            "type": "number"
          }
        },
        "required": [
          "vx",
          "vy",
          "vz"
        ],
        "title": "VelocityNED",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "One Operator velocity command under Manual Control.",
    "properties": {
      "drone_id": {
        "title": "Drone Id",
        "type": "string"
      },
      "velocity_ned": {
        "$ref": "#/$defs/VelocityNED"
      },
      "yaw_rate_dps": {
        "description": "degrees per second, positive clockwise",
        "title": "Yaw Rate Dps",
        "type": "number"
      },
      "ts": {
        "format": "date-time",
        "title": "Ts",
        "type": "string"
      }
    },
    "required": [
      "drone_id",
      "velocity_ned",
      "yaw_rate_dps",
      "ts"
    ],
    "title": "ManualCommand",
    "type": "object"
  },
  "ClampEvent": {
    "$defs": {
      "ManualCommand": {
        "additionalProperties": false,
        "description": "One Operator velocity command under Manual Control.",
        "properties": {
          "drone_id": {
            "title": "Drone Id",
            "type": "string"
          },
          "velocity_ned": {
            "$ref": "#/$defs/VelocityNED"
          },
          "yaw_rate_dps": {
            "description": "degrees per second, positive clockwise",
            "title": "Yaw Rate Dps",
            "type": "number"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "drone_id",
          "velocity_ned",
          "yaw_rate_dps",
          "ts"
        ],
        "title": "ManualCommand",
        "type": "object"
      },
      "VelocityNED": {
        "additionalProperties": false,
        "properties": {
          "vx": {
            "description": "north, m/s",
            "title": "Vx",
            "type": "number"
          },
          "vy": {
            "description": "east, m/s",
            "title": "Vy",
            "type": "number"
          },
          "vz": {
            "description": "down, m/s (positive descends)",
            "title": "Vz",
            "type": "number"
          }
        },
        "required": [
          "vx",
          "vy",
          "vz"
        ],
        "title": "VelocityNED",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A ManualCommand that the Safety Validator altered, and the rule that did it.",
    "properties": {
      "drone_id": {
        "title": "Drone Id",
        "type": "string"
      },
      "original": {
        "$ref": "#/$defs/ManualCommand"
