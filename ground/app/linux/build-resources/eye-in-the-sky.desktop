[Desktop Entry]
Type=Application
Version=1.0
Name=Eye in the Sky
GenericName=Drone Ground Control
Comment=Ground control center for the Eye in the Sky person-following drone
Exec=eye-in-the-sky %U
Icon=eye-in-the-sky
Terminal=false
Categories=Utility;Science;
Keywords=drone;gcs;mavlink;ardupilot;tracking;
StartupWMClass=Eye in the Sky
# Reference copy. electron-builder generates the installed .desktop from the
# `linux.desktop` block in electron-builder.yml; this file is for AppImage/
# Flatpak users who want to register a launcher manually.
