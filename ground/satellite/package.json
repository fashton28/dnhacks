{
  "name": "eis-satellite",
  "version": "0.1.0",
  "private": true,
  "description": "Offline satellite change detection for Eye in the Sky (power-plant security retrofit). Pure-TS detection core (Node + browser), baked synthetic Sentinel-2-style tiles, georeferencing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./data/tiles.json": "./data/tiles.json",
    "./data/anomalies.json": "./data/anomalies.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "npm run build && node scripts/make-tiles.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
