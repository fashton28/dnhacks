# Drone Safety Platform — game-controller access for Manual Control (LINUX_PRD §5)
# ---------------------------------------------------------------------------
# Grants the active desktop user access to common gamepads via `uaccess`, so the
# Chromium Gamepad API in the renderer can read them without running as root.
#
# The .deb/.rpm postinstall installs an equivalent rule automatically. AppImage
# and Flatpak users should copy this file manually:
#
#   sudo cp 99-dnhacks-platform-input.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   # then replug the controller
#
# As a simpler alternative, add your user to the `input` group:
#   sudo usermod -aG input "$USER"   # then log out/in

# Microsoft Xbox controllers (xpad) + generic XInput
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", TAG+="uaccess"
# Sony DualShock 4 / DualSense (hid-playstation / hid-sony)
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", TAG+="uaccess"
# 8BitDo and common third-party pads
SUBSYSTEM=="input", ATTRS{idVendor}=="2dc8", TAG+="uaccess"
# Logitech gamepads
SUBSYSTEM=="input", ATTRS{idVendor}=="046d", TAG+="uaccess"
# Catch-all: any classic joystick/gamepad device node
KERNEL=="js[0-9]*", TAG+="uaccess"
