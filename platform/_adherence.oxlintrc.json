{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/instruments/**",
              "ui_kits/ground-control/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttitudeIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:roll|pitch|size|label|key|ref|className|style|children)$/]",
        "message": "<AttitudeIndicator> doesn't accept that prop. Declared props: roll, pitch, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|mono|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|nominal|caution|danger|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'nominal' | 'caution' | 'danger' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:remaining|voltage|current|cells|compact|key|ref|className|style|children)$/]",
        "message": "<BatteryGauge> doesn't accept that prop. Declared props: remaining, voltage, current, cells, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|block|pending|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, block, pending, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Compass'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|size|target|label|key|ref|className|style|children)$/]",
        "message": "<Compass> doesn't accept that prop. Declared props: heading, size, target, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|status|size|trend|align|style|key|ref|className|style|children)$/]",
        "message": "<GaugeReadout> doesn't accept that prop. Declared props: label, value, unit, status, size, trend, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeReadout'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:default|nominal|caution|danger|accent|muted)$/]",
        "message": "<GaugeReadout> status must be one of 'default' | 'nominal' | 'caution' | 'danger' | 'accent' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeReadout'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<GaugeReadout> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeReadout'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<GaugeReadout> trend must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaugeReadout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<GaugeReadout> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoldButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onConfirm|holdMs|variant|icon|disabled|block|hint|style|key|ref|className|style|children)$/]",
        "message": "<HoldButton> doesn't accept that prop. Declared props: children, onConfirm, holdMs, variant, icon, disabled, block, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoldButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|caution|danger)$/]",
        "message": "<HoldButton> variant must be one of 'primary' | 'caution' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|active|title|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, active, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|icon|onClose|children|footer|width|tone|closeOnBackdrop|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, subtitle, icon, onClose, children, footer, width, tone, closeOnBackdrop."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger|caution|accent)$/]",
        "message": "<Modal> tone must be one of 'default' | 'danger' | 'caution' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|actions|status|children|pad|scroll|variant|bodyStyle|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, icon, actions, status, children, pad, scroll, variant, bodyStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|raised|sunken|flush)$/]",
        "message": "<Panel> variant must be one of 'default' | 'raised' | 'sunken' | 'flush'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:rssi|latencyMs|lost|label|compact|key|ref|className|style|children)$/]",
        "message": "<SignalGauge> doesn't accept that prop. Declared props: rssi, latencyMs, lost, label, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|onChange|disabled|accent|ticks|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, onChange, disabled, accent, ticks, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|pulse|size|solid|dot|icon|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, children, pulse, size, solid, dot, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusPill> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|message|icon|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: severity, title, message, icon, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:info|success|warning|error|critical)$/]",
        "message": "<Toast> severity must be one of 'info' | 'success' | 'warning' | 'error' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|size|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, disabled, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Toggle> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
