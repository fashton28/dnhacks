# ============================================================================
# Drone Safety Platform -- COMPANION autostart unit (Jetson Orin Nano).
# ----------------------------------------------------------------------------
# Runs the companion container on boot via Docker, restarting on failure. The
# companion ALWAYS boots into the safe held state (zero setpoint) and only moves
# on an explicit operator command, so autostart is safe (PRD 11).
#
# Install (on the Jetson):
#   sudo cp companion/systemd/eis-companion.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eis-companion.service
#   journalctl -u eis-companion -f          # follow logs
#
# Assumes:
#   * Docker + the NVIDIA container runtime are installed (see docs/flashing.md).
#   * The image is built/loaded as eis-companion:latest.
#   * Model weights live in /opt/eis/weights and config overrides in /opt/eis/.env.
#   * The FC is wired to /dev/ttyTHS1 (adjust --device for your serial port).
# ============================================================================
[Unit]
Description=Drone Safety Platform companion (person-following drone)
Documentation=https://example.invalid/drone-safety-platform/companion
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple

# Clean up any stale container from a previous run (ignore errors).
ExecStartPre=-/usr/bin/docker rm -f eis-companion

# Host networking so MAVLink UDP, the control WS (8765), and RTSP/WebRTC
# (8554/8889) are reachable on the LAN without port mapping. --runtime nvidia
# exposes the GPU for TensorRT inference. The FC serial device is passed in.
ExecStart=/usr/bin/docker run --rm --name eis-companion \
    --runtime nvidia \
    --network host \
    --device /dev/ttyTHS1 \
    -v /opt/eis/weights:/app/weights \
    --env-file /opt/eis/.env \
    -e EIS_CONFIG=config/default.yaml \
    eis-companion:latest

ExecStop=/usr/bin/docker stop -t 10 eis-companion

# Resilience: always come back up (it boots safe), with a backoff.
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Give MAVLink + GStreamer time to come up before considering a start failed.
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
